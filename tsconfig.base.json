{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,

    // Relative imports keep their real ".ts" extension in the source and are
    // rewritten to ".js" on emit -- ESM needs an extension, and pointing at a
    // file that does not exist in the source tree confuses every other tool.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  }
}

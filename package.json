{
  "name": "claudops",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @claudops/server dev",
    "dev:web": "pnpm --filter @claudops/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "tsc": "pnpm -r exec tsc",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @claudops/e2e e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}

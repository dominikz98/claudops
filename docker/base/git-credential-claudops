#!/bin/sh
# Git-Credential-Helper: liefert GIT_TOKEN aus der Umgebung.
#
# Vorteil gegenüber einem Token in der Clone-URL: es landet weder in
# .git/config noch in `git remote -v` noch in Fehlermeldungen von git.
#
# GIT_TOKEN_HOST (vom Entrypoint aus REPO_URL abgeleitet) begrenzt die Ausgabe
# auf den Host des Projekt-Repos — ein `git clone` gegen einen fremden Host
# bekommt das Token nicht zu sehen.
set -u

[ "${1:-}" = "get" ] || exit 0
[ -n "${GIT_TOKEN:-}" ] || exit 0

host=""
while IFS='=' read -r key value; do
  [ -n "$key" ] || break
  case "$key" in
    host) host="$value" ;;
  esac
done

if [ -n "${GIT_TOKEN_HOST:-}" ] && [ "$host" != "$GIT_TOKEN_HOST" ]; then
  exit 0
fi

echo "username=${GIT_USERNAME:-x-access-token}"
echo "password=${GIT_TOKEN}"

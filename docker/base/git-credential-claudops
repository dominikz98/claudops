#!/bin/sh
# Git credential helper: serves GIT_TOKEN from the environment.
#
# Advantage over a token in the clone URL: it ends up neither in .git/config
# nor in `git remote -v` nor in error messages from git.
#
# GIT_TOKEN_HOST (derived from REPO_URL by the entrypoint) limits the output to
# the host of the project repo -- a `git clone` against a foreign host never
# gets to see the token.
set -u

[ "${1:-}" = "get" ] || exit 0
[ -n "${GIT_TOKEN:-}" ] || exit 0

host=""
while IFS='=' read -r key value; do
  [ -n "$key" ] || break
  case "$key" in
    host) host="$value" ;;
  esac
done

if [ -n "${GIT_TOKEN_HOST:-}" ] && [ "$host" != "$GIT_TOKEN_HOST" ]; then
  exit 0
fi

echo "username=${GIT_USERNAME:-x-access-token}"
echo "password=${GIT_TOKEN}"
